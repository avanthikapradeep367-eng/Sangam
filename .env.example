# Copy to .env and fill in. .env is ignored by Git. These are read only on the server
# (Vite dev server / server/index.mjs) — never prefix them with VITE_.

# Azure AI Translator (Translator resource → Keys and Endpoint)
AZURE_TRANSLATOR_KEY=your-translator-key
# Required for regional or multi-service resources, e.g. centralindia. Leave empty for a global resource.
AZURE_TRANSLATOR_REGION=your-translator-region
# Optional; defaults to https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_ENDPOINT=

# Azure AI Speech (Speech resource → Keys and Endpoint)
AZURE_SPEECH_KEY=your-speech-key
# The resource's region, e.g. centralindia (must offer ta-IN-PallaviNeural)
AZURE_SPEECH_REGION=your-speech-region

# Production server port (server/index.mjs)
PORT=8787
